services:
  web:
    build:
      context: .
      dockerfile: Dockerfile.web
    image: commonshub-brussels-web:latest
    container_name: commonshub-web
    restart: unless-stopped
    ports:
      - "${PORT:-3000}:${PORT:-3000}"
    volumes:
      # The website only reads pre-generated data. Populate ./data separately
      # with the chb pipeline before starting the site.
      - ./data:/data:ro
    environment:
      - NODE_ENV=production
      - DATA_DIR=/data
      - PORT=${PORT:-3000}

      # Website runtime secrets only.
      - AUTH_DISCORD_ID=${AUTH_DISCORD_ID}
      - AUTH_DISCORD_SECRET=${AUTH_DISCORD_SECRET}
      - RESEND_API_KEY=${RESEND_API_KEY}
      - NEXTAUTH_URL=${NEXTAUTH_URL:-http://localhost:3000}
      - NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
      - WEBHOOK_SECRET=${WEBHOOK_SECRET}

    # Read-only root filesystem (supply-chain attack mitigation)
    # Only /tmp and /run are writable; /data is mounted read-only.
    read_only: true
    tmpfs:
      - /tmp
      - /run
    security_opt:
      - no-new-privileges:true

    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:${PORT:-3000}/status.json >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 2G
